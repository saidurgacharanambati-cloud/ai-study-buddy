# Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
# Create a .env file by copying this file: copy .env.example .env
# Then replace your_api_key_here with your actual Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Port for local development (defaults to 3000 if omitted)
PORT=3000
